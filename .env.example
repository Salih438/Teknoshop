# ==============================================================================
# TEKNOSHOP — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development or configure in Vercel
# ==============================================================================

# 1. DATABASE (PostgreSQL / Neon Serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# 2. AUTHENTICATION (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# 3. APPLICATION URL & STORE BRANDING
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="TEKNOSHOP TEKNOLOJİ A.Ş."

# 4. FILE UPLOADS (UploadThing)
# Required for product gallery and customer avatar uploads
UPLOADTHING_TOKEN="eyJhbGciOi..."

# 5. TRANSACTIONAL EMAIL (Resend - Optional)
# If omitted, transactional order confirmation emails are simulated cleanly in the server console
RESEND_API_KEY="re_..."
EMAIL_FROM="Teknoshop <onboarding@resend.dev>"

# 6. DISTRIBUTED RATE LIMITING (Upstash Redis - Optional)
# If omitted, the application seamlessly falls back to robust in-memory sliding-window rate limiting
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
