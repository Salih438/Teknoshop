generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS (SABİT LİSTELER) =================

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING    // Bekliyor
  PROCESSING // Hazırlanıyor
  SHIPPED    // Kargoya Verildi
  DELIVERED  // Teslim Edildi
  CANCELLED  // İptal Edildi
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// 🚀 YENİ: Dinamik ödeme türleri için sistem seviyesi kategorizasyon
enum PaymentType {
  CREDIT_CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

// ================= MODELLER (TABLOLAR) =================

// 1. KULLANICI YÖNETİMİ
model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  password  String? // OAuth (Google vs) ile girişler için nullable olabilir
  phone     String?
  role      Role    @default(USER)
  isActive  Boolean @default(true)
  avatarUrl String? // <-- Profil fotoğrafı URL'si

  // İlişkiler
  addresses Address[]
  orders    Order[]
  cart      Cart?     // Bir kullanıcının 1 sepeti olur (1-to-1)
  reviews   Review[]
  favorites Favorite[]
  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         String  @id @default(uuid())
  title      String  // Ev, İş vb.
  city       String
  district   String
  address    String
  postalCode String?

  isDefault  Boolean @default(false) // Bu kullanıcının varsayılan adresi mi?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[] // Bu adrese verilen siparişler

  createdAt DateTime @default(now())

  // PERFORMANS İYİLEŞTİRMESİ
  @@index([userId])
}

// 2. KATALOG VE ÜRÜN YÖNETİMİ
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String
  price       Float
  stock       Int    @default(0)

  imageUrl    String   // Katalog ve sepet için ana kapak fotoğrafı
  sku         String?  @unique          // Stok Kodu / Barkod (Örn: SMS25-256)
  isActive    Boolean  @default(true)   // Ürün yayında mı? (Aktif/Pasif)
  salesCount  Int      @default(0)      // Satış sayısı istatistiği
  viewCount   Int      @default(0)      // Görüntülenme istatistiği

  // İlişkiler
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  images     ProductImage[] // Çoklu fotoğraf galerisi
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  
  // 🚀 YENİ: Ürünün Sahip Olduğu Varyasyonlar
  variants   ProductVariant[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PERFORMANS İYİLEŞTİRMESİ
  @@index([categoryId])
  @@index([brandId])
}

// Ürün Çoklu Galeri Tablosu
model ProductImage {
  id       String @id @default(uuid())
  imageUrl String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // PERFORMANS İYİLEŞTİRMESİ
  @@index([productId])
}

// 🚀 YENİ TABLO: Ürün Varyasyonları (Örn: Siyah / 128GB)
model ProductVariant {
  id        String  @id @default(uuid())
  
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  color     String? // Opsiyonel renk seçeneği
  storage   String? // Opsiyonel hafıza seçeneği
  
  price     Float?  // Varyasyona özel fiyat (Boşsa ana ürünün fiyatı geçerli olur)
  stock     Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// 3. SEPET YÖNETİMİ
model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // 🚀 YENİ: Sepetteki ürünün seçilen varyasyonu (Eski sepetleri bozmamak için nullable)
  variantId String? 
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // PERFORMANS İYİLEŞTİRMESİ
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// 4. SİPARİŞ VE ÖDEME
model PaymentMethod {
  id          String      @id @default(uuid())
  name        String      
  description String?     
  type        PaymentType 
  fee         Float       @default(0) 
  isActive    Boolean     @default(true)
  
  payments    Payment[]   
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id         String      @id @default(uuid())
  totalPrice Float
  discountAmount Float   @default(0)
  status     OrderStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?
  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PERFORMANS İYİLEŞTİRMESİ
  @@index([userId])
}

model OrderItem {
  id       String @id @default(uuid())
  quantity Int
  price    Float 

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // 🚀 YENİ: Sipariş edilen ürünün seçilen varyasyonu
  variantId String? 
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  // PERFORMANS İYİLEŞTİRMESİ
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id            String        @id @default(uuid())
  status        PaymentStatus @default(PENDING)
  transactionId String? 

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  paidAt DateTime?
}

model Shipment {
  id             String  @id @default(uuid())
  trackingNumber String?
  company        String? 

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isVerified Boolean @default(false)
  isHidden   Boolean @default(false)
  
  @@unique([userId, productId]) 
  @@index([productId])
  @@index([userId]) 
}

model Favorite {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) 
  @@index([productId]) 
  @@index([userId]) 
}

model Coupon {
  id         String   @id @default(uuid())
  code       String   @unique
  discount   Float 
  minAmount  Float?
  isSingleUse Boolean @default(false)
  usageLimit Int      @default(100)
  usedCount  Int      @default(0)
  expireDate DateTime

  isActive Boolean @default(true)
  isDeleted   Boolean @default(false)

  usages CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}
// 5. MAĞAZA VE KARGO AYARLARI (YENİ EKLENDİ)
model StoreSettings {
  id                String   @id @default(uuid())
  shippingCompany   String   @default("Yurtiçi Kargo") // Kargo şirketi adı
  shippingFee       Float    @default(149.99)          // Kargo ücreti
  freeShippingThreshold Float @default(5000.00)        // Ücretsiz kargo limiti
  
  updatedAt         DateTime @updatedAt
}