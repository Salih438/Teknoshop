generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS (SABİT LİSTELER) =================

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING    // Bekliyor
  PROCESSING // Hazırlanıyor
  SHIPPED    // Kargoya Verildi
  DELIVERED  // Teslim Edildi
  CANCELLED  // İptal Edildi
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  CREDIT_CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
  DIGITAL_WALLET
  INSTALLMENT
}

enum PaymentProvider {
  CUSTOM
  IYZICO
  PAYTR
  STRIPE
  GARANTI
  AKBANK
  PAPARA
  FAST
  APPLE_PAY
  GOOGLE_PAY
}

enum ReturnStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  COMPLETED
  REJECTED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  SIZE_FIT
  NOT_AS_DESCRIBED
  CHANGE_OF_MIND
  OTHER
}

enum ExchangeStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING_FOR_CUSTOMER
  WAITING_STOCK
  SHIPPED
  RECEIVED
  PROCESSING
  COMPLETED
}

enum ExchangeReason {
  SIZE_CHANGE
  COLOR_CHANGE
  DEFECTIVE_REPLACEMENT
  WRONG_ITEM_SENT
  OTHER
}

enum AdminNotificationType {
  LOW_STOCK
  NEW_ORDER
  ORDER_CANCELLED
  RETURN_REQUEST
  EXCHANGE_REQUEST
  SYSTEM
  USER_REGISTERED
}

enum UserNotificationType {
  ORDER_CREATED
  ORDER_PREPARING
  ORDER_SHIPPED
  ORDER_DELIVERED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURN_COMPLETED
  EXCHANGE_APPROVED
  EXCHANGE_REJECTED
  EXCHANGE_RECEIVED
  EXCHANGE_SHIPPED
  EXCHANGE_COMPLETED
  NEW_COUPON
  NEW_CAMPAIGN
  SYSTEM_ANNOUNCEMENT
}

enum AuditRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Permission {
  VIEW_DASHBOARD
  VIEW_ANALYTICS
  MANAGE_PRODUCTS
  DELETE_PRODUCTS
  MANAGE_ORDERS
  MANAGE_USERS
  DELETE_USERS
  MANAGE_COUPONS
  MANAGE_RETURNS
  MANAGE_EXCHANGES
  MANAGE_NOTIFICATIONS
  VIEW_AUDIT
  MANAGE_SETTINGS
  MANAGE_PAYMENT_METHODS
  MANAGE_BRANDS
  MANAGE_CATEGORIES
  EXPORT_REPORTS
  MANAGE_ROLES
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER_SUPPORT
  CONTENT_MANAGER
  ANALYST
}

// ================= MODELLER (TABLOLAR) =================

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  password  String?
  phone     String?
  role      Role       @default(USER)
  systemRole SystemRole @default(ADMIN)
  isActive  Boolean    @default(true)

  avatarUrl String?

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  favorites Favorite[]
  couponUsages CouponUsage[]
  returns   ReturnRequest[]
  exchanges ExchangeRequest[]
  notifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         String  @id @default(uuid())
  title      String
  city       String
  district   String
  address    String
  postalCode String?

  isDefault  Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String
  price       Float
  comparePrice Float?
  stock       Int    @default(0)

  imageUrl    String
  sku         String?  @unique
  isActive    Boolean  @default(true)
  salesCount  Int      @default(0)
  viewCount   Int      @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  requestedExchanges ExchangeItem[]
  variants   ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id       String @id @default(uuid())
  imageUrl String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  color     String?
  storage   String?

  combination     String?
  discountedPrice Float?
  sku             String?
  isActive        Boolean @default(true)
  
  price     Float?
  stock     Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]
  requestedVariantExchanges ExchangeItem[]

  @@index([productId])
  @@index([sku])
}

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  items  CartItem[]
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String? 
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// 4. SİPARİŞ VE ENTERPRISE ÖDEME MİMARİSİ
model PaymentMethod {
  id           String          @id @default(uuid())
  name         String          
  description  String?         
  type         PaymentType     @default(CREDIT_CARD)
  provider     PaymentProvider @default(CUSTOM)
  fee          Float           @default(0)
  displayOrder Int             @default(0)
  icon         String?         
  isActive     Boolean         @default(true)
  
  bankAccounts BankAccount[]
  payments     Payment[]   
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model BankAccount {
  id              String        @id @default(uuid())
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  bankName        String
  accountHolder   String
  iban            String
  currency        String        @default("TRY")
  branchCode      String?
  accountNumber   String?
  isActive        Boolean       @default(true)

  createdAt       DateTime      @default(now())

  @@index([paymentMethodId])
}

model Order {
  id         String      @id @default(uuid())
  totalPrice Float
  discountAmount Float   @default(0)
  status     OrderStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?
  couponUsages CouponUsage[]
  returns  ReturnRequest[]
  exchanges ExchangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveredAt DateTime?

  @@index([userId])
}

model OrderItem {
  id                String @id @default(uuid())
  quantity          Int
  returnedQuantity  Int    @default(0)
  exchangedQuantity Int    @default(0)
  price             Float 

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String? 
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  returnItems   ReturnItem[]
  exchangeItems ExchangeItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id             String        @id @default(uuid())
  status         PaymentStatus @default(PENDING)
  transactionId  String? 
  refundedAmount Float         @default(0)
  refundedAt     DateTime?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  paidAt DateTime?
}

model Shipment {
  id             String  @id @default(uuid())
  trackingNumber String?
  company        String? 

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isVerified Boolean @default(false)
  isHidden   Boolean @default(false)
  
  @@unique([userId, productId]) 
  @@index([productId])
  @@index([userId]) 
}

model Favorite {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) 
  @@index([productId]) 
  @@index([userId]) 
}

model Coupon {
  id         String   @id @default(uuid())
  code       String   @unique
  discount   Float 
  minAmount  Float?
  isSingleUse Boolean @default(false)
  usageLimit Int      @default(100)
  usedCount  Int      @default(0)
  expireDate DateTime

  isActive Boolean @default(true)
  isDeleted   Boolean @default(false)

  usages CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model StoreSettings {
  id                String   @id @default(uuid())
  shippingCompany   String   @default("Yurtiçi Kargo") 
  shippingFee       Float    @default(149.99)          
  freeShippingThreshold Float @default(5000.00)        
  
  phone             String?
  email             String?
  address           String?
  workingHours      String?
  
  updatedAt         DateTime @updatedAt
}

model ReturnRequest {
  id                   String       @id @default(uuid())
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status               ReturnStatus @default(PENDING)
  refundAmount         Float        @default(0)
  refundMethod         String?      
  returnTrackingNumber String?      
  customerNote         String?      @db.Text
  adminNote            String?      @db.Text
  
  approvedAt           DateTime?
  receivedAt           DateTime?
  completedAt          DateTime?
  
  items                ReturnItem[]
  images               ReturnImage[]
  
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([orderId, status])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  quantity        Int           @default(1)
  reason          ReturnReason  @default(OTHER)
  refundAmount    Float         @default(0)

  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
  @@index([orderItemId])
  @@index([orderItemId, returnRequestId])
}

model ReturnImage {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  imageUrl        String
  
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
}

model ExchangeRequest {
  id                         String         @id @default(uuid())
  orderId                    String
  order                      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId                     String
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status                     ExchangeStatus @default(PENDING)
  returnTrackingNumber       String?        
  newShipmentTrackingNumber  String?        
  customerNote               String?        @db.Text
  adminNote                  String?        @db.Text
  
  approvedAt                 DateTime?
  receivedAt                 DateTime?
  completedAt                DateTime?
  
  items                      ExchangeItem[]
  
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([orderId, status])
}

model ExchangeItem {
  id                 String          @id @default(uuid())
  exchangeRequestId  String
  exchangeRequest    ExchangeRequest @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)
  orderItemId        String
  orderItem          OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  requestedProductId String?
  requestedProduct   Product?        @relation(fields: [requestedProductId], references: [id])
  requestedVariantId String?
  requestedVariant   ProductVariant? @relation(fields: [requestedVariantId], references: [id])
  
  quantity           Int             @default(1)
  reason             ExchangeReason  @default(SIZE_CHANGE)

  createdAt          DateTime        @default(now())

  @@index([exchangeRequestId])
  @@index([orderItemId])
  @@index([orderItemId, exchangeRequestId])
}

model AdminNotification {
  id        String                @id @default(uuid())
  type      AdminNotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean               @default(false)
  metadata  String?
  createdAt DateTime              @default(now())

  @@index([isRead, createdAt])
  @@index([type, createdAt])
  @@index([metadata])
}

model AuditLog {
  id         String         @id @default(uuid())
  adminId    String
  adminName  String
  adminEmail String?
  action     String
  entityType String
  entityId   String?
  entityName String?
  riskLevel  AuditRiskLevel @default(LOW)
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, createdAt])
  @@index([riskLevel, createdAt])
}

model UserNotification {
  id         String               @id @default(uuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       UserNotificationType
  title      String
  message    String               @db.Text
  linkUrl    String?
  entityType String?
  entityId   String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}